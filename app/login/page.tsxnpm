'use client'
import { useState } from 'react'

export default function LoginPage() {
  const [email, setEmail] = useState('')
  const [password, setPassword] = useState('')
  const [message, setMessage] = useState('')

  const handleLogin = () => {
    setMessage('✅ تم الضغط! البريد: ' + email)
  }

  return (
    <div style={{ 
      minHeight: '100vh', 
      display: 'flex', 
      alignItems: 'center', 
      justifyContent: 'center',
      background: 'linear-gradient(135deg, #667eea 0%, #764ba2 100%)',
      fontFamily: 'Arial, sans-serif'
    }}>
      <div style={{ 
        background: 'white', 
        padding: '40px', 
        borderRadius: '15px', 
        boxShadow: '0 10px 40px rgba(0,0,0,0.2)',
        width: '90%',
        maxWidth: '400px'
      }}>
        <h1 style={{ 
          textAlign: 'center', 
          color: '#333',
          marginBottom: '30px'
        }}>
          تسجيل الدخول
        </h1>
        
        <input
          type="email"
          placeholder="البريد الإلكتروني"
          value={email}
          onChange={(e) => setEmail(e.target.value)}
          style={{ 
            width: '100%', 
            padding: '15px', 
            marginBottom: '15px', 
            fontSize: '16px',
            borderRadius: '8px',
            border: '2px solid #e0e0e0',
            boxSizing: 'border-box'
          }}
        />
        
        <input
          type="password"
          placeholder="كلمة المرور"
          value={password}
          onChange={(e) => setPassword(e.target.value)}
          style={{ 
            width: '100%', 
            padding: '15px', 
            marginBottom: '20px', 
            fontSize: '16px',
            borderRadius: '8px',
            border: '2px solid #e0e0e0',
            boxSizing: 'border-box'
          }}
        />
        
        <button
          onClick={handleLogin}
          style={{ 
            width: '100%', 
            padding: '15px', 
            background: '#667eea', 
            color: 'white', 
            fontSize: '18px',
            fontWeight: 'bold',
            borderRadius: '8px',
            border: 'none',
            cursor: 'pointer'
          }}
        >
          دخول
        </button>
        
        {message && (
          <p style={{ 
            marginTop: '20px', 
            textAlign: 'center', 
            color: 'green',
            fontWeight: 'bold'
          }}>
            {message}
          </p>
        )}
      </div>
    </div>
  )
}
